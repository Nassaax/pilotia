# Variables d'environnement à configurer dans Vercel → Project → Settings →
# Environment Variables (jamais dans le code ni commité dans ce fichier).
# Ce fichier documente ce qui existe ; il ne contient aucune vraie clé.

# --- Capture d'email (ressources.html, outils.html) et envoi du rapport ---
# Créer un compte sur https://www.brevo.com (gratuit jusqu'à 300 emails/jour),
# puis Settings → SMTP & API → API Keys → Generate a new API key.
BREVO_API_KEY=

# Optionnel : identifiant numérique d'une liste de contacts Brevo
# (Contacts → Listes → cliquer sur la liste → l'ID est dans l'URL).
# Sans elle, les contacts sont créés mais rattachés à aucune liste précise.
BREVO_LIST_ID=

# Adresse d'expédition des emails transactionnels (doit être un domaine/adresse
# vérifié dans Brevo : Settings → Senders & IP). Défaut si absent : contact@pilotia.be
BREVO_SENDER_EMAIL=

# --- Formulaire de contact (contact.html) ---
# Adresse qui RECEVOIT les messages du formulaire. Si elle n'est pas définie,
# BREVO_SENDER_EMAIL est utilisée à la place ; si aucune des deux n'existe, le
# formulaire répond clairement qu'il n'est pas configuré plutôt que de perdre
# le message en silence.
CONTACT_RECIPIENT=

# --- Rapport diagnostic détaillé généré par IA (rapport-diagnostic.html) ---
# Créer une clé sur https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude à utiliser. Défaut : claude-sonnet-5
ANTHROPIC_MODEL=
